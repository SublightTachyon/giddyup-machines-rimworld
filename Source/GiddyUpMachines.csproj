<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Harmony's RimWorld 1.6 Workshop build is the net472 asset. Targeting
         the same framework avoids Mono binding to Harmony's distinct net48 image. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GiddyUpMachines</AssemblyName>
    <RootNamespace>GiddyUpMachines</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../1.6/Assemblies/</OutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
